{
  "name": "fmx",
  "version": "0.3.1",
  "packageManager": "bun@1.4.0",
  "description": "A lightweight terminal multiplexer for Fx Conversations",
  "type": "module",
  "bin": {
    "fmx": "./src/index.ts",
    "fmx-mcp": "./src/mcp.ts"
  },
  "scripts": {
    "contracts:check": "bun scripts/check-agentworkplace-contracts.ts",
    "contracts:phase1a-provider": "bun scripts/generate-agentworkplace-phase1a-provider.ts",
    "contracts:provider": "bun scripts/generate-agentworkplace-provider.ts",
    "gallery": "bun ui-gallery/cli.ts",
    "gallery:check": "bun ui-gallery/cli.ts --check",
    "install:source": "scripts/install.sh --install",
    "gate:local": "scripts/local-gate.sh",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:phase1c-real": "scripts/phase1c-real-process-composition-acceptance.sh",
    "test:pty": "FMX_RUN_PTY_TESTS=1 bun test tests/multiplexer.e2e.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opentui/core": "0.5.6",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "license": "MIT"
}
