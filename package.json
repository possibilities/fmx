{
  "name": "fmx",
  "version": "0.3.1",
  "packageManager": "bun@1.4.0",
  "description": "A terminal multiplexer driven over a socket",
  "type": "module",
  "bin": {
    "fmx": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:pty": "FMX_RUN_PTY_TESTS=1 bun test tests/instance.e2e.test.ts",
    "install:source": "scripts/install.sh --install",
    "gate:local": "scripts/local-gate.sh"
  },
  "dependencies": {
    "@opentui/core": "0.5.6",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "license": "MIT"
}
